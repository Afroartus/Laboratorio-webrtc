# Etapa de compilación: el toolchain de Go solo existe aquí.
FROM docker.io/library/golang:1.26.3-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOOS=linux GOFLAGS=-trimpath

# Capa de dependencias separada para aprovechar la caché (go.sum aparecerá con
# la primera dependencia externa).
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN go vet ./... \
 && go test ./... \
 && go build -ldflags="-s -w" -o /out/server ./cmd/server

# Etapa de ejecución: imagen mínima sin shell, usuario no root y certificados
# raíz incluidos para conexiones TLS salientes. Fijada por digest.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:d4df213e27178b79e05ee2bdf8a23d8c54baab3b5a0dc083b039ad9929fa4219
COPY --from=build /out/server /app/server
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/server"]
