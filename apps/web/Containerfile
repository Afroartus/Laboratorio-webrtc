# Etapa de compilación: Node solo existe aquí y solo compila la SPA.
FROM docker.io/library/node:24.18.0-alpine3.24 AS build
WORKDIR /src
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY . .
RUN npm run check && npm run build

# Etapa final: Caddy sirve los estáticos y hace de proxy HTTPS/WSS.
# El Caddyfile se monta en solo lectura desde infra/ (no se hornea en la imagen).
FROM docker.io/library/caddy:2.11.7-alpine
COPY --from=build /src/dist /srv
EXPOSE 8443
