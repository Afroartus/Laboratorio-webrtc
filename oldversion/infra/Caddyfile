{
	https_port 8443
	auto_https disable_redirects
	local_certs
	skip_install_trust
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$WEB_DOMAIN}:8443 {
	tls internal
	import security_headers
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://{$RTC_DOMAIN}:8443 wss://{$RTC_DOMAIN}:8443; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Permissions-Policy "camera=(self), microphone=(self)"
	}

	@webhook path /api/v1/webhooks/*
	handle @webhook {
		respond "No encontrado" 404
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$RTC_DOMAIN}:8443 {
	tls internal
	import security_headers

	@signal {
		path /rtc /rtc/*
		header Origin https://{$WEB_DOMAIN}:8443
	}
	handle @signal {
		reverse_proxy livekit:7880
	}
	handle {
		respond "No encontrado" 404
	}
}