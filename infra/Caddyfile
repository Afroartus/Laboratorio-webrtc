# Caddy del laboratorio: SPA, proxy /api y señalización WSS de LiveKit con TLS local.
# WEB_DOMAIN y RTC_DOMAIN llegan como variables de entorno desde compose.yaml.
{
	# Puerto HTTPS dentro del contenedor; compose lo publica en LAB_HOST_IP:8443.
	https_port 8443
	# Sin redirección HTTP->HTTPS: el laboratorio solo publica 8443.
	auto_https disable_redirects
	# CA interna de Caddy (volumen caddy_data). Su raíz pública se instala a mano en los clientes.
	local_certs
	skip_install_trust
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$WEB_DOMAIN}:8443 {
	tls internal
	import security_headers
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$RTC_DOMAIN}:8443 {
	tls internal
	import security_headers

	# Señalización y API HTTP de LiveKit. Los medios no pasan por aquí (7881/tcp, 7882/udp).
	reverse_proxy livekit:7880
}
