FROM docker.io/library/golang:1.26.3-alpine AS build


WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download

COPY app/cmd/ ./app/cmd/


RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/api \
    ./app/cmd


FROM scratch

# COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /out/api  /api

USER 10001:10001

ENV PORT=8080
ENV SCOPE=local
EXPOSE 8080

ENTRYPOINT ["/api"]